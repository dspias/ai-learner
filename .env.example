# ---- Database ----
# For `make dev` on the host, Postgres is published on localhost:5432.
# Inside docker-compose, the app service overrides this to use host "db".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_learner?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app (used for callbacks).
AUTH_URL="http://localhost:3000"
# Trust the local host header in dev.
AUTH_TRUST_HOST="true"

# ---- First user (created by the seed) ----
SEED_USER_EMAIL="pias@matrix777.io"
SEED_USER_PASSWORD="changeme123"
SEED_USER_NAME="Pias"

# ---- LLM provider ----
# Which provider to use: "anthropic" or "openai". Switch by changing this and
# restarting the app (docker compose restart app / make restart).
LLM_PROVIDER="anthropic"

# ---- Anthropic ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- OpenAI ----
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ---- Stripe (billing) ----
# From the Stripe dashboard (use test-mode keys for development).
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` or the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring Price IDs for each paid plan (create Products/Prices in Stripe).
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_MAX="price_..."
